# Local development defaults only. These values are NOT secrets: they match the
# docker-compose.yml development services and must never be used in production.
DATABASE_URL=postgres://fitadapt:fitadapt-dev-only@127.0.0.1:5432/fitadapt
TEST_DATABASE_URL=postgres://fitadapt:fitadapt-dev-only@127.0.0.1:5432/fitadapt_test
REDIS_URL=redis://127.0.0.1:6379
# Development-only signing key (>= 32 chars). Generate a real one per environment.
AUTH_JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
# Pepper for hashing one-time codes and refresh tokens (dev-only value).
AUTH_TOKEN_PEPPER=dev-only-pepper-change-me-0000000000000
API_PORT=3000
# Reverse proxies in front of the API (0 locally; the M19 edge sets its exact hop count, see ADR-025).
TRUST_PROXY_HOPS=0
# Optional observability. Leave empty to disable (no-op).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# M11 AI coach: model provider key, server-side only (never in the app). Leave empty to run the coach
# without a model (deterministic answers from the app's guide and the engine's reason codes).
ANTHROPIC_API_KEY=
