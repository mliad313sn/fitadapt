{
  "name": "fitadapt-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter api test:integration",
    "licences:check": "node tooling/scripts/check-licences.mjs",
    "security:audit": "node tooling/security/scripts/audit-gate.mjs",
    "security:secrets": "node tooling/security/scripts/secret-scan.mjs",
    "security:sast": "eslint --no-config-lookup -c tooling/security/eslint.security.config.mjs --max-warnings 0 .",
    "security:check": "pnpm security:audit && pnpm security:secrets && pnpm security:sast",
    "compliance:check": "node tooling/security/scripts/compliance-check.mjs",
    "legal:build": "turbo run build --filter=@fitadapt/legal-tooling^... --output-logs=errors-only",
    "legal:claims": "pnpm -s legal:build && node tooling/legal/scripts/claims.mjs",
    "legal:licences": "node tooling/legal/scripts/licences.mjs",
    "legal:docs": "pnpm -s legal:build && node tooling/legal/scripts/docs.mjs",
    "legal:store": "pnpm -s legal:build && node tooling/legal/scripts/store.mjs",
    "legal:check": "pnpm legal:claims && pnpm legal:licences && pnpm legal:docs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-security": "4.0.1",
    "globals": "17.12.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
