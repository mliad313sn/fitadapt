{
  "name": "@fitadapt/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:integration": "turbo run build --filter=@fitadapt/api^... --output-logs=errors-only && vitest run --config vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.0",
    "@fitadapt/shared": "workspace:*",
    "@fitadapt/sync": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.1"
  }
}
