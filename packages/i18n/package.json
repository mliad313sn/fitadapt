    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vitest": "5.0.1"
  }
